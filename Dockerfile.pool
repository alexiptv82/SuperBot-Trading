# Immagine del runner del pool di regole (paper in avanti, solo dati pubblici).
# Completamente separata dal bot: niente chiavi di exchange, nessuna porta aperta.
FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app/backend PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir "ccxt==4.2.95" "numpy>=1.26.0" "pandas>=2.2.0"

COPY backend/strategy_lab.py ./backend/strategy_lab.py
COPY backend/rule_pool ./backend/rule_pool
RUN mkdir -p /app/data/pool

HEALTHCHECK --interval=5m --timeout=20s --start-period=10m --retries=2 \
  CMD python -m rule_pool.cli health --data-dir /app/data/pool

CMD ["python", "-m", "rule_pool.cli", "loop", "--data-dir", "/app/data/pool"]
