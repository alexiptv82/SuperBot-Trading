# Esempio. Non mettere chiavi vere in questo file.

# Provider del Brain. deepseek è il default e lascia il comportamento attuale.
BRAIN_LLM_PROVIDER=deepseek

# Vale quando BRAIN_LLM_PROVIDER=free_router. Se la variabile manca, il fallback è acceso.
# false lo spegne: un router guasto diventa NO_TRADE, senza chiamare DeepSeek.
DEEPSEEK_FALLBACK=true

# Router locale OpenAI-compatibile (FreeLLMAPI). Solo rete privata, di solito loopback.
LLM_ROUTER_URL=http://127.0.0.1:3001/v1
LLM_ROUTER_KEY=replace-with-the-local-unified-key
LLM_ROUTER_MODEL=auto:smart
LLM_ROUTER_TIMEOUT_S=30

# Solo se il router NON è su questa macchina. Default: rifiuta gli host pubblici.
# LLM_ROUTER_ALLOW_REMOTE=false
