# RC84 — TEMPLATE ONLY; NOT INSTALLED, ENABLED OR STARTED.
# New PAPER wallet only, never /opt/superbot-desk-data/hawk.
[Unit]
Description=SuperBot V3 Falco NEW PAPER strategy (paused-first)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/superbot-v3-rc84-stage
Environment=DESK_MODE=paper
Environment=DESK_PORTFOLIO=hawk
Environment=DESK_DATA_DIR=/opt/superbot-v3-paper-runs/classic-hawk-paper20261111
Environment=DESK_LONG_S25=1
Environment=PYTHONPATH=/opt/superbot-v3-rc84-stage/backend
Environment=PYTHONDONTWRITEBYTECODE=1
# Do not start until secrets have been provisioned OUTSIDE GitHub repo.
EnvironmentFile=/etc/superbot-v3-paper/falco-ai.env
ExecStartPre=/usr/bin/test -f /opt/superbot-v3-paper-runs/classic-hawk-paper20261111/pause.flag
ExecStart=/opt/superbot-v3-rc70-stage/.venv/bin/python3 -m desk.cli loop --portfolio hawk
Restart=on-failure
RestartSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/superbot-v3-paper-runs/classic-hawk-paper20261111
# Intentionally NO Install section: explicit user-approved start only.
