# RC84 — TEMPLATE ONLY; NOT INSTALLED, ENABLED OR STARTED.
# New PAPER wallet only, never /opt/superbot-desk-data/bull.
[Unit]
Description=SuperBot V3 Toro NEW PAPER strategy (paused-first)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/superbot-v3-rc84-stage
Environment=DESK_MODE=paper
Environment=DESK_PORTFOLIO=bull
Environment=DESK_DATA_DIR=/opt/superbot-v3-paper-runs/classic-bull-paper20261111
Environment=DESK_LONG_S25=1
Environment=PYTHONPATH=/opt/superbot-v3-rc84-stage/backend
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/superbot-v3-paper/toro-ai.env
ExecStartPre=/usr/bin/test -f /opt/superbot-v3-paper-runs/classic-bull-paper20261111/PREPARED_PAUSED_ONLY.json
ExecStart=/opt/superbot-v3-rc70-stage/.venv/bin/python3 -m desk.cli loop --portfolio bull
Restart=on-failure
RestartSec=15
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/superbot-v3-paper-runs/classic-bull-paper20261111
# Intentionally NO Install section: explicit user-approved start only.
