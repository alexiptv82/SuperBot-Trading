[Unit]
Description=SuperBot backup esterno cifrato - Brain V3 (affianca quello di Falco/Toro)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Il programma rifiuta di partire da qui se manca /opt/superbot-extbackup-v2/brain/timer-gate.json (scritto dall'installatore
# solo dopo la prova di un backup reale e di un ripristino indipendente).
Environment=SUPERBOT_V3_SCHEDULED=1
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=45min
# Uscita 3 («niente da proteggere») NON e' un successo: il servizio risulta fallito e si vede.
ExecStart=/opt/superbot-extbackup-v3/run-v3.sh --mode v3
# Dopo un arresto brusco o un timeout restano solo file temporanei NOSTRI. La pulizia gira SOLO se riesce a prendere lo stesso
# .lock che prende ogni backup (flock -n): se nel frattempo c'e' un backup MANUALE in corso (che tiene il .lock), la pulizia non
# parte e non puo' toccare i suoi file temporanei. Il "-" iniziale ignora l'esito (nessun lock libero = niente da pulire).
ExecStopPost=-/usr/bin/flock -n /opt/superbot-extbackup-v2/brain/v3/.lock /bin/sh -c 'rm -rf /opt/superbot-extbackup-v2/brain/v3/staging /opt/superbot-extbackup-v2/brain/v3/scratch /opt/superbot-extbackup-v2/brain/v3/staging.tar.gz; rm -f /opt/superbot-extbackup-v2/brain/v3/superbot-brainv3-*.tar.gz.age /opt/superbot-extbackup-v2/brain/v3/superbot-brainv3-*.tar.gz.age.part*'
